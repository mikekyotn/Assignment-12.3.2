<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment_12._3._2.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="30" Margin="5">
            <Label Text="Pet List" FontSize="40" HorizontalOptions="Center" />
            <CollectionView ItemsSource="{Binding PetList}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="20,*,*,Auto,Auto">
                            <Label Grid.Column="0" Text="{Binding Id}" HorizontalOptions="End" FontSize="16" />
                            <Label Grid.Column="1" Text="{Binding Type}" HorizontalOptions="Center" FontSize="16"/>
                            <Label Grid.Column="2" Text="{Binding Name}" HorizontalOptions="Center" FontSize="16"/>
                            <Button Grid.Column="3" Text="Delete" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                            <Button Grid.Column="4" Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding .}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,*">
                <Label Grid.Row="0" Grid.Column="0" Text="Type of Dog: "/>
                <Entry x:Name="txtNewDogType" Grid.Row="0" Grid.Column="1" />
                <Label Grid.Row="0" Grid.Column="2" Text="New Dog's Name: "/>
                <Entry x:Name="txtNewDogName" Grid.Row="0" Grid.Column="3"/>
                <Button x:Name="btnAddNewDog" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Add New" Clicked="OnAddNewClicked" FontAttributes="Bold" FontSize="14"/>
                <Button x:Name="btnSave" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Save" Clicked="OnSaveClicked" FontAttributes="Bold" FontSize="14"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
